{
	"name": "website",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vp dev",
		"build": "vp build",
		"preview": "vp preview",
		"deploy": "npm run build && wrangler deploy",
		"cf-typegen": "wrangler types",
		"format": "vp fmt",
		"lint": "vp lint && npm run lint:css",
		"lint:css": "stylelint \"src/**/*.css\"",
		"check": "vp check && npm run lint:css",
		"test": "vp test run"
	},
	"dependencies": {
		"@tanstack/react-devtools": "0.10.13",
		"@tanstack/react-router": "1.170.45",
		"@tanstack/react-router-devtools": "1.167.2",
		"@tanstack/react-router-ssr-query": "1.167.3",
		"@tanstack/react-start": "1.169.3",
		"downshift": "^9.4.0",
		"oxc-transform-react": "^0.152.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.64.0",
		"@tanstack/devtools-vite": "0.8.5",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"babel-plugin-react-compiler": "^1.0.0",
		"jsdom": "^30.1.3",
		"stylelint": "^17.16.0",
		"stylelint-config-standard": "^40.0.0",
		"typescript": "^7.0.2",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
		"vite-plus": "1.3.0",
		"wrangler": "^4.151.1"
	},
	"overrides": {
		"vite": "npm:@voidzero-dev/vite-plus-core@1.3.0"
	},
	"stylelint": {
		"extends": [
			"stylelint-config-standard"
		],
		"rules": {
			"property-no-vendor-prefix": [
				true,
				{
					"ignoreProperties": [
						"-webkit-text-size-adjust",
						"-webkit-user-select"
					]
				}
			],
			"selector-class-pattern": null
		}
	},
	"allowScripts": {
		"fsevents": true,
		"sharp": true,
		"esbuild": true,
		"workerd": true
	}
}
